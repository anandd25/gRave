# Copy this file to backend/.env and fill in ONE of the options below.
# backend/.env is gitignored. Never commit real keys.

# Option A: Groq (free tier). Either variable name works.
# Groq retired its Llama models for free accounts in Aug 2026. Defaults to openai/gpt-oss-120b.
GROQ_API_KEY=
# GRAVE_LLM_MODEL=openai/gpt-oss-120b   # best plans (default)
# GRAVE_LLM_MODEL=openai/gpt-oss-20b    # faster, lighter
# GRAVE_LLM_TPM=8000                    # your tokens-per-minute limit; raise it if you upgrade your Groq tier

# Optional: Tavily web search. Lets the producer look up the style you ask for
# ("Memphis horrorcore", "like a horror trailer"). Only your text is sent, never audio.
TAVILY_API_KEY=

# Option B: Anthropic (Claude)
# ANTHROPIC_API_KEY=
# GRAVE_LLM_MODEL=claude-sonnet-4-5

# Option C: OpenAI
# OPENAI_API_KEY=
# GRAVE_LLM_MODEL=gpt-4o-mini

# Option D: any OpenAI-compatible server, e.g. a local Ollama (no key needed)
# GRAVE_LLM_BASE_URL=http://localhost:11434/v1
# GRAVE_LLM_MODEL=llama3.1
